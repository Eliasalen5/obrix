// Obrix — esquema de base de datos
// PostgreSQL (Prisma Postgres) en todos los entornos. Sin enums de Prisma:
// los "enums" se modelan como String + constantes/Zod en src/lib.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  nombre       String
  rol          String     @default("CLIENTE") // ADMIN | COMERCIO | CLIENTE
  createdAt    DateTime   @default(now())
  comercio     Comercio?
  cotizaciones Cotizacion[]
  pedidos      Pedido[]
  solicitudesRevisadas SolicitudProducto[]
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String     @unique
  orden     Int        @default(0)
  productos Producto[]
}

model Producto {
  id          String            @id @default(cuid())
  sku         String            @unique
  nombre      String
  unidad      String // "bolsa 50 kg", "unidad", "m", "litro", "m²", ...
  descripcion String            @default("")
  // Identificación canónica para detección de duplicados (catálogo maestro)
  codigoBarras    String?   @unique // identificador confiable cuando existe
  fabricante      String    @default("")
  codigoFabricante String?
  marca           String    @default("") // marca canónica del producto maestro
  atributos       Json?     // medidas, peso, dimensiones, etc. (variables)
  categoriaId String
  categoria   Categoria         @relation(fields: [categoriaId], references: [id])
  ofertas     Oferta[]
  itemsPedido ItemPedido[]
  materiales  MaterialCotizacion[]
  solicitudes SolicitudProducto[]
  createdAt   DateTime          @default(now())
}

// Propuesta de un comercio para incorporar un producto al catálogo maestro.
// El producto propuesto NO se publica hasta que un ADMIN apruebe.
model SolicitudProducto {
  id             String    @id @default(cuid())
  comercioId     String
  comercio       Comercio  @relation(fields: [comercioId], references: [id])
  estado         String    @default("PENDIENTE_REVISION") // PENDIENTE_REVISION | APROBADA | VINCULADA | RECHAZADA
  datos          Json // propuesta canónica (nombre, categoría, marca, códigos, atributos, precio/stock iniciales)
  clavePendiente String? // clave normalizada de la propuesta; se limpia al resolver
  productoId     String? // producto maestro resultante (al aprobar o vincular)
  producto       Producto? @relation(fields: [productoId], references: [id])
  motivoRechazo  String    @default("")
  revisadoById   String?
  revisadoBy     Usuario?  @relation(fields: [revisadoById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Anti doble envío: un solo envío pendiente idéntico por comercio.
  // En Postgres los NULL no chocan, así que las solicitudes resueltas no bloquean.
  @@unique([comercioId, clavePendiente])
  @@index([estado])
  @@index([comercioId, estado])
}

model Comercio {
  id        String    @id @default(cuid())
  nombre    String
  direccion String
  lat       Float
  lng       Float
  telefono  String    @default("")
  activo    Boolean   @default(true)
  ownerId   String    @unique
  owner     Usuario   @relation(fields: [ownerId], references: [id])
  ofertas   Oferta[]
  pedidos   Pedido[]
  solicitudes SolicitudProducto[]
  createdAt DateTime  @default(now())
}

model Oferta {
  id           String   @id @default(cuid())
  comercioId   String
  comercio     Comercio @relation(fields: [comercioId], references: [id])
  productoId   String
  producto     Producto @relation(fields: [productoId], references: [id])
  precio       Float
  stock        Int      @default(0) // -1 = sin control de stock
  marca        String   @default("")
  presentacion String   @default("")
  activo       Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@unique([comercioId, productoId])
}

model Cotizacion {
  id        String              @id @default(cuid())
  prompt    String // lo que pidió el usuario
  estado    String              @default("BORRADOR") // BORRADOR | ENVIADA | COMPARADA
  clienteId String?
  cliente   Usuario?            @relation(fields: [clienteId], references: [id])
  materiales MaterialCotizacion[]
  pedidos   Pedido[]
  resultadoJson String? // snapshot de la comparación al momento de cotizar (inmutable)
  createdAt DateTime            @default(now())
}

model MaterialCotizacion {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])
  productoId   String?
  producto     Producto?  @relation(fields: [productoId], references: [id])
  nombre       String // snapshot del material pedido por la IA
  cantidad     Float
  unidad       String
}

model Pedido {
  id           String       @id @default(cuid())
  clienteId    String
  cliente      Usuario      @relation(fields: [clienteId], references: [id])
  comercioId   String
  comercio     Comercio     @relation(fields: [comercioId], references: [id])
  cotizacionId String?
  cotizacion   Cotizacion?  @relation(fields: [cotizacionId], references: [id])
  estado       String       @default("PENDIENTE") // PENDIENTE | CONFIRMADO | PREPARADO | ENTREGADO | CANCELADO
  total        Float        @default(0)
  createdAt    DateTime     @default(now())
  items        ItemPedido[]
}

model ItemPedido {
  id            String   @id @default(cuid())
  pedidoId      String
  pedido        Pedido   @relation(fields: [pedidoId], references: [id])
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id])
  cantidad      Float
  precioUnitario Float // precio al momento de comprar
}
