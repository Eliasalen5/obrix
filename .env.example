# PostgreSQL (Prisma Postgres). Usar la connection string TCP del panel de Prisma/la integración de Vercel.
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000
IA_API_KEY=changeme
IA_MODEL=gpt-4o-mini
IA_BASE_URL=https://api.openai.com/v1
IA_DEMO=true
IA_TIMEOUT_MS=15000
RATE_LIMIT_PER_MIN=10
LOGIN_RATE_LIMIT_PER_MIN=8
REGISTRO_RATE_LIMIT_PER_MIN=5
# "memory" para desarrollo/tests; "upstash" en producción con las credenciales REST.
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SEED_DEMO_PASSWORD=obrix1234
